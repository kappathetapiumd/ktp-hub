// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  BROTHER
  PCP_PCVP
  PLEDGE
  NONE
}

model User {
  id             String @id @default(cuid())
  email          String @unique
  name           String
  hashedPassword String
  salt           String

  role                Role    @default(NONE)
  membershipCommittee Boolean @default(false)
  isActive            Boolean @default(true)

  philSmallEvent      Boolean @default(false)
  philBigEvent        Boolean @default(false)
  profDevEventA       Boolean @default(false)
  profDevEventB       Boolean @default(false)

  pledgeStrikeEvents  StrikeEvent[] @relation("PledgeStrikeEvents")
  createdStrikeEvents StrikeEvent[] @relation("CreatedStrikeEvents")
}

model StrikeEvent {
  id String @id @default(cuid())

  pledgeId String
  pledge   User   @relation("PledgeStrikeEvents", fields: [pledgeId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedStrikeEvents", fields: [createdById], references: [id])

  amount Int
  reason String

  createdAt DateTime @default(now())
}

model StrikeTerm {
  id          String @id @default(cuid())

  startDate   DateTime
  endDate     DateTime
}

model GroupTask {
  id String @id @default(cuid())

  name        String
  completed   Boolean @default(false)
}

model Link {
  id String @id @default(cuid())

  label String
  url   String
}

model Session {
  sessionId           String  @id @unique
  userId              String
  role                Role
  membershipCommittee Boolean

  expiresAt DateTime
}
