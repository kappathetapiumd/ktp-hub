// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  BROTHER
  PCP_PCVP
  PLEDGE
  NONE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String

  role         Role     @default(NONE)

  membershipCommittee Boolean @default(false)

  isActive     Boolean @default(true)

  pledgeStrikeEvents  StrikeEvent[] @relation("PledgeStrikeEvents")
  createdStrikeEvents StrikeEvent[] @relation("CreatedStrikeEvents")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StrikeEvent {
  id          String   @id @default(cuid())

  pledgeId   String
  pledge     User     @relation("PledgeStrikeEvents", fields: [pledgeId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedStrikeEvents", fields: [createdById], references: [id])

  amount      Int
  reason      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StrikeTerm {
  id        String   @id @default(cuid())
  
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
